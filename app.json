{
  "expo": {
    "name": "BillWise PK",
    "slug": "billwise-pk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "billwisepk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adnan.billwisepk"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#080E1A"
      },
      "package": "com.adnan.billwisepk",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "BillWise uses the camera to take a photo of your bill so it can read the amount and due date.",
          "photosPermission": "BillWise opens your photos so you can choose a picture of a bill."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://billwise-pk.vercel.app"
    }
  }
}
