# Copy this file to ".env.local" for local testing. Never commit real keys.
#
# --- Server (set these in Vercel → Project → Settings → Environment Variables) ---
# Your Claude API key from https://platform.claude.com — required for reading bills.
ANTHROPIC_API_KEY=
# Optional: any random text. If set, the app must send the same value (below).
BILLWISE_APP_KEY=
#
# --- App (EXPO_PUBLIC_ values are built INTO the app, so they are not secret) ---
# Where the server lives. Defaults to https://billwise-pk.vercel.app (app.json → extra.apiUrl).
EXPO_PUBLIC_API_URL=
# Must match BILLWISE_APP_KEY above, if you set one.
EXPO_PUBLIC_BILLWISE_APP_KEY=
